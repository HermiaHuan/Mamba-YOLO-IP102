# Copy this file to .env and fill in your own API key.
# The real .env file is ignored by Git and should not be uploaded.

# OpenAI-compatible API key. Either OPENAI_API_KEY or AGRI_LLM_API_KEY works.
OPENAI_API_KEY=your_api_key_here

# Optional: OpenAI-compatible chat completions endpoint and model name.
AGRI_LLM_API_URL=https://api.openai.com/v1/chat/completions
AGRI_LLM_MODEL=gpt-4o-mini
AGRI_LLM_TIMEOUT=20
